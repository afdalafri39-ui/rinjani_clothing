// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  price       Float
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  material    String?
  weight      String?
  featured    Boolean          @default(false)
  status      String           @default("DRAFT")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      ProductImage[]
  variants    ProductVariant[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  stock     Int     @default(0)
  sku       String?
}

model CustomOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  garmentModel    String
  garmentCategory String?
  color           String
  colorHex        String?
  fabric          String
  fabricWeight    String?
  printingMethod  String
  sizes           String   // JSON string: {"M": 2, "L": 3}
  totalQuantity   Int      @default(1)
  notes           String?
  designFiles     String?  // JSON string: ["file1.png", "file2.pdf"]
  status          String   @default("BARU") // BARU, DIPROSES, MOCKUP, PRODUKSI, SELESAI, DIBATALKAN
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id                   String   @id @default("default")
  brandName            String   @default("Rinjani Clothing")
  whatsappNumber       String?
  whatsappEnabled      Boolean  @default(false)
  telegramUsername     String?
  telegramEnabled      Boolean  @default(false)
  instagramUrl         String?
  email                String?
  address              String?
  orderMessageTemplate String?
  currency             String   @default("IDR")
  customOrdersSheetWebhook  String?
  productOrdersSheetWebhook String?
  updatedAt            DateTime @updatedAt
}

model ProductOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique // PO-YYYYMMDD-XXXX
  customerName  String
  customerPhone String
  customerEmail String?
  productName   String
  productSlug   String?
  price         Float    @default(0)
  quantity      Int      @default(1)
  size          String?
  color         String?
  totalPrice    Float    @default(0)
  notes         String?
  status        String   @default("BARU") // BARU, DIPROSES, DIKIRIM, SELESAI, DIBATALKAN
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomGarment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String   @default("T-Shirt")
  description String?
  price       Float    @default(0)
  minOrder    Int      @default(12)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  images      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

